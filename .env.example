# Official Portaldot V3 testnet.
# Copy this file to .env.local. The app reads these NEXT_PUBLIC_ variables
# and falls back to the confirmed chain id, token, and decimals when one
# is unset. Leave either RPC URL empty and the sample-data banner stays up.
# Report cards read live scores from the ScoreRegistry contract.
#
# H160 account ids on this network are not Ethereum addresses.
#
# Not env vars (see lib/config.ts): chain name PortaldotV3 Test,
# SS58 prefix 42, 6s blocks, 600-block sessions, 6 sessions per era (~6h),
# history depth 84 eras. The staking pallet does not publish a nomination
# limit; NOMINATION_CAP stays 16.

# Confirmed chain id. Fallback when unset: 420420777
NEXT_PUBLIC_CHAIN_ID=420420777

# Confirmed token symbol. Fallback when unset: tPOT
NEXT_PUBLIC_TOKEN_SYMBOL=tPOT

# Confirmed token decimals. Fallback when unset: 14
NEXT_PUBLIC_TOKEN_DECIMALS=14

# Substrate WSS. Staking, session, era points, chills, slashes.
NEXT_PUBLIC_SUBSTRATE_RPC_URL=wss://test-node-v3.portaldot.dev

# EVM JSON-RPC. Score-contract reads (grade, score, era, publishing tx).
NEXT_PUBLIC_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev

# Block explorer origin, no trailing slash. Used by "Verify on-chain" links.
# Fallback when unset: https://scanner-testnet-v3.portaldot.dev
# That scanner opens a publish at /#/blocks/{height}?tab=events (the block's
# revive.ContractEmitted log from ScoreRegistry). The hash is required.
# The node console (https://node-console.portaldot.dev) is an SPA.
# /tx/{hash} is not a route. A block opens at
# /?rpc=wss%3A%2F%2Ftest-node-v3.portaldot.dev#/explorer/query/{height}
# Set this to https://node-console.portaldot.dev to use that hash route.
NEXT_PUBLIC_EXPLORER_URL=https://scanner-testnet-v3.portaldot.dev

# ScoreRegistry on the V3 testnet. Scores are read from its ScorePublished
# logs. Fallbacks when unset: the address and deploy block below.
NEXT_PUBLIC_SCORE_REGISTRY_ADDRESS=0xeebc363c7af7ed8e888da07e959043517ae4b97d
NEXT_PUBLIC_SCORE_REGISTRY_FROM_BLOCK=107303

# "live" (default) reads the contract. "mock" shows the sample validators.
NEXT_PUBLIC_DATA_SOURCE=live

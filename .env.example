# Portaldot V3 testnet is not confirmed. The previous wss endpoint is down.
# Leave the RPC URLs empty and the app shows sample data with a banner.
# H160 account ids on this network are not Ethereum addresses.
#
# The commented values are unconfirmed placeholders. The app uses them
# only when the matching variable is unset. They are not a live chain.

# Chain id. Fallback when unset: 420420777
NEXT_PUBLIC_CHAIN_ID=

# Canonical token symbol. Fallback when unset: tPOTv3
# Report cards shorten that placeholder to tPOT.
NEXT_PUBLIC_TOKEN_SYMBOL=

# Token decimals. Fallback when unset: 14
NEXT_PUBLIC_TOKEN_DECIMALS=

# Substrate JSON-RPC (wss or https). Staking, session, era points, chills, slashes.
# No confirmed endpoint yet. Leave blank.
NEXT_PUBLIC_SUBSTRATE_RPC_URL=

# EVM JSON-RPC. Score-contract reads (grade, score, era, publishing tx).
# No confirmed endpoint yet. Leave blank.
NEXT_PUBLIC_EVM_RPC_URL=

# Block explorer origin, no trailing slash. Used by "view on-chain" links.
NEXT_PUBLIC_EXPLORER_URL=

# Nomination cap is not an env var. It stays the placeholder
# NOMINATION_CAP = 16 in lib/config.ts until the chain publishes a limit.
